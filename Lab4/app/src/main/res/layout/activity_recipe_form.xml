<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">
        <TextView
            android:id="@+id/tvFormTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Новый рецепт"
            android:textColor="@color/text_primary"
            android:textSize="25sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/ivFormPhoto"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/placeholder_food"
            android:contentDescription="Фотография результата"
            android:scaleType="centerCrop" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnChoosePhoto"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Из галереи"
                android:textAllCaps="false" />
            <Button
                android:id="@+id/btnTakePhoto"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Снять камерой"
                android:textAllCaps="false" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/progressPhoto"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="5dp"
            android:indeterminate="true"
            android:visibility="gone" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Название блюда *" android:textColor="@color/text_primary" android:textStyle="bold" />
        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Например, паста карбонара"
            android:inputType="textCapSentences"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:backgroundTint="@color/purple" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Категория" android:textColor="@color/text_primary" android:textStyle="bold" />
        <EditText
            android:id="@+id/etCategory"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Завтрак, обед, десерт..."
            android:inputType="textCapSentences"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:backgroundTint="@color/purple" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Время приготовления, минут" android:textColor="@color/text_primary" android:textStyle="bold" />
        <EditText
            android:id="@+id/etMinutes"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="30"
            android:inputType="number"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:backgroundTint="@color/purple" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Ингредиенты *" android:textColor="@color/text_primary" android:textStyle="bold" />
        <EditText
            android:id="@+id/etIngredients"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:gravity="top|start"
            android:hint="Каждый ингредиент — с новой строки"
            android:inputType="textMultiLine|textCapSentences"
            android:padding="12dp"
            android:backgroundTint="@color/purple" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Пошаговое описание *" android:textColor="@color/text_primary" android:textStyle="bold" />
        <EditText
            android:id="@+id/etSteps"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:gravity="top|start"
            android:hint="1. Подготовьте продукты..."
            android:inputType="textMultiLine|textCapSentences"
            android:padding="12dp"
            android:backgroundTint="@color/purple" />
        <Button
            android:id="@+id/btnSaveRecipe"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="18dp"
            android:background="@drawable/rounded_button"
            android:text="Сохранить рецепт"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
