<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="FinTrack" android:textColor="@color/text_primary"
            android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Простой учёт личных финансов" android:textColor="@color/text_secondary"
            android:textSize="14sp" android:layout_marginTop="2dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@android:color/white"
            android:padding="16dp" android:layout_marginTop="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Баланс основного счёта" android:textColor="@color/text_secondary" />
            <TextView android:id="@+id/balanceText" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0,00 ₽"
                android:textColor="@color/text_primary" android:textSize="28sp"
                android:textStyle="bold" android:layout_marginTop="4dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="12dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Доходы за месяц" android:textSize="12sp" android:textColor="@color/text_secondary" />
                    <TextView android:id="@+id/incomeText" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0,00 ₽"
                        android:textColor="@color/green" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Расходы за месяц" android:textSize="12sp" android:textColor="@color/text_secondary" />
                    <TextView android:id="@+id/expenseText" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="0,00 ₽"
                        android:textColor="@color/red" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <Button android:id="@+id/addButton" android:layout_width="match_parent"
            android:layout_height="52dp" android:layout_marginTop="12dp"
            android:text="＋ Добавить операцию" android:textAllCaps="false"
            android:textColor="@android:color/white" android:background="@drawable/bg_button" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="6dp">
            <Button android:id="@+id/budgetsButton" android:layout_width="0dp"
                android:layout_height="48dp" android:layout_weight="1"
                android:text="Лимиты" android:textAllCaps="false" />
            <Button android:id="@+id/paymentsButton" android:layout_width="0dp"
                android:layout_height="48dp" android:layout_weight="1"
                android:layout_marginStart="8dp" android:text="Платежи" android:textAllCaps="false" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Контроль лимитов" android:textColor="@color/text_primary"
            android:textSize="19sp" android:textStyle="bold" android:layout_marginTop="20dp" />
        <LinearLayout android:id="@+id/budgetsBox" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginTop="8dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Операции" android:textColor="@color/text_primary"
            android:textSize="19sp" android:textStyle="bold" android:layout_marginTop="20dp" />
        <TextView android:id="@+id/emptyText" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Операций пока нет. Добавьте первый доход или расход."
            android:textColor="@color/text_secondary" android:padding="14dp"
            android:layout_marginTop="8dp" />
        <LinearLayout android:id="@+id/transactionsBox" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
